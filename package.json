{
  "name": "desktop-pet",
  "version": "0.1.1",
  "private": true,
  "description": "Cross-platform Electron desktop pet client",
  "author": "tao",
  "license": "GPL-3.0",
  "main": "src/main/main.js",
  "type": "commonjs",
  "build": {
    "appId": "com.tao.desktoppet",
    "productName": "Desktop Pet",
    "files": [
      "dist/renderer/**/*",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  },
  "scripts": {
    "dev": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "DESKTOP_PET_SKIP_ELECTRON_SMOKE=1 playwright test",
    "build": "vite build",
    "landing:dev": "vite --config vite.landing.config.js",
    "landing:build": "vite build --config vite.landing.config.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "ffmpeg-static": "^5.3.0",
    "gifuct-js": "^2.1.2",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
